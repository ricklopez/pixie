{
  "name": "@gateway/cli",
  "version": "0.1.0",
  "private": true,
  "description": "pixie: local developer CLI for the Pixie gateway (installed from this checkout; not published to npm)",
  "type": "module",
  "bin": {
    "pixie": "./bin/pixie.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx test/*.test.ts"
  },
  "dependencies": {
    "@gateway/definition": "*",
    "@gateway/recorder": "*"
  },
  "devDependencies": {
    "tsx": "^4.20.6"
  }
}
